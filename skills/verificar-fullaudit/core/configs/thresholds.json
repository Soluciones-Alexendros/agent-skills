{
  "version": "3.0.0",
  "origen": {
    "verificar-compliance": "cwv detallado, contraste_wcag, on_page, semaforo, dictamen, rice 3 sprints, severidad_horas_defecto",
    "web-playwright": "crawler, ui, cwv plano, motion, seo, semaforo, veredicto, rice_sprints 4 sprints, viewports, personas"
  },
  "crawler": {
    "max_depth": 12,
    "max_pages": 150,
    "pagination_param": "page",
    "pagination_max": 5,
    "ignore_paths": [
      "/logout",
      "/admin",
      "/wp-admin",
      "/wp-login"
    ],
    "timeout_ms": 20000
  },
  "ui": {
    "touch_target_min_px": 44,
    "touch_target_hard_min_px": 24,
    "font_size_min_px": 12,
    "line_height_min": 1.4,
    "grid_pt": 8,
    "header_max_viewport_pct": 25,
    "cta_prominence_pct": [
      15,
      20
    ],
    "min_gap_px": 8
  },
  "motion": {
    "transition_max_ms": 500
  },
  "viewports": {
    "desktop": 1440,
    "tablet": 768,
    "mobile": 390
  },
  "personas": [
    "visitante_nuevo",
    "usuario_logueado",
    "mobile_user"
  ],
  "cwv": {
    "lcp_ms": {
      "bueno": 2500,
      "mejorable": 4000
    },
    "inp_ms": {
      "bueno": 200,
      "mejorable": 500
    },
    "cls": {
      "bueno": 0.1,
      "mejorable": 0.25
    },
    "ttfb_ms": {
      "bueno": 800,
      "mejorable": 1800
    },
    "fcp_ms": {
      "bueno": 1800,
      "mejorable": 3000
    }
  },
  "contraste_wcag": {
    "aa_texto_normal": 4.5,
    "aa_texto_grande": 3.0,
    "aa_componentes_ui": 3.0,
    "aaa_texto_normal": 7.0,
    "aaa_texto_grande": 4.5
  },
  "on_page": {
    "title_chars": {
      "min": 30,
      "optimo_min": 50,
      "optimo_max": 60,
      "max": 65
    },
    "meta_description_chars": {
      "min": 70,
      "optimo_min": 150,
      "optimo_max": 160,
      "max": 170
    },
    "img_alt_cobertura_min": 0.98,
    "img_dimensions_cobertura_min": 0.95,
    "security_headers_min": 4
  },
  "seo_rangos": {
    "title_chars": [
      50,
      60
    ],
    "meta_description_chars": [
      120,
      158
    ]
  },
  "semaforo": {
    "verde": 90,
    "ambar": 70
  },
  "dictamen": {
    "positivo": {
      "max_fail_criticos": 0,
      "min_pct_pilar": {
        "ACC": 90,
        "TEC": 85,
        "LEG": 90
      },
      "min_pct_global": 85
    },
    "parcial": {
      "min_pct_global": 70
    },
    "notas": "1 FAIL Crítico => NEGATIVO. Por debajo de umbral global de parcial => NEGATIVO. N/A se excluye del denominador. PENDING se excluye del denominador pero se reporta."
  },
  "veredicto_e2e": {
    "apto": {
      "max_fail_criticas": 0,
      "min_pct_global": 90
    },
    "apto_con_observaciones": {
      "max_fail_criticas": 0,
      "min_pct_global": 70
    },
    "notas": "1 FAIL Crítica => NO APTO. WARN cuenta como incumplimiento parcial. N/A excluido del denominador."
  },
  "rice": {
    "sprints": [
      {
        "nombre": "Sprint 0",
        "plazo": "48h",
        "severidades": [
          "Crítico"
        ],
        "objetivo": "Estabilizar: la web no rompe ni pierde conversiones"
      },
      {
        "nombre": "Sprint 1",
        "plazo": "Semana 1",
        "severidades": [
          "Alto"
        ],
        "objetivo": "Usable y accesible: 100% funcional + WCAG AA"
      },
      {
        "nombre": "Sprint 2",
        "plazo": "Semana 2",
        "severidades": [
          "Medio"
        ],
        "objetivo": "Profesionalizar: CWV verde y UI unificada"
      },
      {
        "nombre": "Sprint 3",
        "plazo": "Semana 3",
        "severidades": [
          "Bajo"
        ],
        "objetivo": "SEO y delight: pulido final"
      }
    ]
  },
  "severidad_horas_defecto": {
    "Crítico": 8,
    "Alto": 6,
    "Medio": 4,
    "Bajo": 2
  }
}